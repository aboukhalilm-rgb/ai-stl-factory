from __future__ import annotations

import json
from pathlib import Path

from flask import Flask, jsonify, redirect, render_template_string, request, session, url_for
from werkzeug.security import check_password_hash, generate_password_hash

from config import BASE_DIR, DEFAULT_CATEGORIES, ensure_initial_password, get_config_summary, get_setting, set_setting, write_env
from key_rotator import GroqKeyRotator
from scheduler import STLFactoryScheduler
from stl_generator import GenerationRequest, STLGenerator

app = Flask(__name__)
app.secret_key = get_setting("APP_SECRET_KEY", "change-me")

SCHEDULER_INSTANCE: STLFactoryScheduler | None = None


def password_is_valid(password: str) -> bool:
    stored_hash = get_setting("APP_PASSWORD_HASH", "")
    if stored_hash:
        return check_password_hash(stored_hash, password)
    legacy_password = get_setting("APP_PASSWORD", "")
    return bool(legacy_password and password == legacy_password)


@app.before_request
def ensure_setup():
    if request.path in {"/setup", "/login", "/static", "/favicon.ico"}:
        return
    if not get_setting("APP_PASSWORD_HASH") and not get_setting("APP_PASSWORD"):
        return redirect(url_for("setup_page"))


@app.route("/setup", methods=["GET", "POST"])
def setup_page():
    if request.method == "POST":
        password = request.form.get("password", "").strip()
        if not password:
            return "Password is required.", 400
        set_setting("APP_PASSWORD_HASH", generate_password_hash(password))
        if not get_setting("APP_SECRET_KEY"):
            set_setting("APP_SECRET_KEY", "change-me")
        app.secret_key = get_setting("APP_SECRET_KEY", app.secret_key)
        session["authenticated"] = True
        return redirect(url_for("index"))

    return """
    <html><body>
      <h2>Initial setup</h2>
      <form method="post">
        <label>Password: <input type="password" name="password" required></label>
        <button type="submit">Set password</button>
      </form>
    </body></html>
    """


@app.route("/login", methods=["GET", "POST"])
def login_page():
    if request.method == "POST":
        password = request.form.get("password", "")
        if password_is_valid(password):
            session["authenticated"] = True
            return redirect(url_for("index"))
        return "Invalid password", 401

    return """
    <html><body>
      <h2>Login</h2>
      <form method="post">
        <input type="password" name="password" required>
        <button type="submit">Login</button>
      </form>
    </body></html>
    """


@app.route("/logout")
def logout():
    session.pop("authenticated", None)
    return redirect(url_for("login_page"))


@app.route("/")
def index():
    if not session.get("authenticated"):
        return redirect(url_for("login_page"))

    summary = get_config_summary()
    category_options = "".join(f"<option value='{category}'>{category}</option>" for category in DEFAULT_CATEGORIES)
    log_path = BASE_DIR / "logs" / "factory.log"
    log_text = log_path.read_text(encoding="utf-8", errors="ignore") if log_path.exists() else "No logs yet."

    return render_template_string(
        """
        <html>
        <head><title>AI STL Creation Factory</title></head>
        <body>
            <h1>AI STL Creation Factory</h1>
            <p><a href="/logout">Logout</a></p>

            <h2>Manual generation</h2>
            <form action="/api/generate" method="post">
                <label>Category:
                    <select name="category">
                        <option value="">Random</option>
                        {{ category_options | safe }}
                    </select>
                </label><br>
                <label>Copy count: <input type="number" name="count" value="1" min="1" max="10"></label><br>
                <label>Size mm: <input type="number" name="size_mm" value="80" step="0.1"></label><br>
                <label>Custom parameters (JSON):
                    <textarea name="custom_parameters" rows="5">{"style": "industrial"}</textarea>
                </label><br>
                <button type="submit">Generate</button>
            </form>

            <h2>Settings</h2>
            <form action="/api/settings" method="post">
                <label>Groq API keys: <input type="text" name="GROQ_API_KEYS" value="{{ summary.get('groq_keys') }}" style="width: 420px;"></label><br>
                <label>Default model: <input type="text" name="GROQ_DEFAULT_MODEL" value="llama-3.3-70b-versatile"></label><br>
                <label>Telegram bot token: <input type="text" name="TELEGRAM_BOT_TOKEN" value=""></label><br>
                <label>Telegram chat ID: <input type="text" name="TELEGRAM_CHAT_ID" value=""></label><br>
                <label>Google Drive folder ID: <input type="text" name="GOOGLE_DRIVE_FOLDER_ID" value=""></label><br>
                <label>App secret: <input type="text" name="APP_SECRET_KEY" value="{{ summary.get('app_name') }}"></label><br>
                <button type="submit">Save settings</button>
            </form>

            <h2>Scheduler</h2>
            <p>Auto-run interval: {{ summary.get('scheduler_seconds') }} seconds</p>
            <a href="/api/scheduler/start">Start scheduler</a> |
            <a href="/api/scheduler/stop">Stop scheduler</a>

            <h2>Logs</h2>
            <pre>{{ log_text }}</pre>
        </body>
        </html>
        """,
        category_options=category_options,
        summary=summary,
        log_text=log_text,
    )


@app.route("/api/health")
def healthcheck():
    return jsonify({
        "status": "ok",
        "app_name": get_setting("APP_NAME", "AI STL Creation Factory"),
        "password_set": bool(get_setting("APP_PASSWORD_HASH")),
    })


@app.route("/api/generate", methods=["POST"])
def generate_manual():
    if not session.get("authenticated"):
        return jsonify({"error": "Authentication required"}), 401

    category = request.form.get("category", "")
    count = max(1, min(int(request.form.get("count", 1) or 1), 10))
    size_mm = request.form.get("size_mm")
    custom_parameters_text = request.form.get("custom_parameters", "")
    try:
        custom_parameters = json.loads(custom_parameters_text) if custom_parameters_text else {}
    except json.JSONDecodeError:
        custom_parameters = {"raw": custom_parameters_text}
    if size_mm:
        custom_parameters["size_mm"] = float(size_mm)

    generator = STLGenerator(GroqKeyRotator())
    try:
        result = generator.generate_model(GenerationRequest(category=category, count=count, custom_parameters=custom_parameters))
        return jsonify({"status": "ok", "result": result})
    except Exception as exc:
        return jsonify({"status": "failed", "error": str(exc)}), 500


@app.route("/api/settings", methods=["POST"])
def settings_update():
    if not session.get("authenticated"):
        return jsonify({"error": "Authentication required"}), 401

    payload: dict[str, str] = {}
    for key in [
        "GROQ_API_KEYS",
        "GROQ_DEFAULT_MODEL",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID",
        "GOOGLE_DRIVE_FOLDER_ID",
        "APP_SECRET_KEY",
        "APP_PORT",
        "APP_NAME",
        "SCHEDULER_INTERVAL_SECONDS",
    ]:
        value = request.form.get(key, "").strip()
        if value:
            payload[key] = value
    if payload:
        write_env(payload)
        app.secret_key = get_setting("APP_SECRET_KEY", app.secret_key)
    return redirect(url_for("index"))


@app.route("/api/scheduler/start")
def scheduler_start():
    global SCHEDULER_INSTANCE
    if not session.get("authenticated"):
        return jsonify({"error": "Authentication required"}), 401
    if SCHEDULER_INSTANCE is None:
        SCHEDULER_INSTANCE = STLFactoryScheduler()
    SCHEDULER_INSTANCE.start()
    return jsonify({"status": "scheduler_started"})


@app.route("/api/scheduler/stop")
def scheduler_stop():
    global SCHEDULER_INSTANCE
    if not session.get("authenticated"):
        return jsonify({"error": "Authentication required"}), 401
    if SCHEDULER_INSTANCE is not None:
        SCHEDULER_INSTANCE.stop()
    return jsonify({"status": "scheduler_stopped"})


if __name__ == "__main__":
    ensure_initial_password()
    app.run(host="0.0.0.0", port=int(get_setting("APP_PORT", "5000")), debug=False)
